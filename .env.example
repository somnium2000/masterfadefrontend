# MasterFade Frontend env example
# Vite embebe estas variables al ejecutar build. Compilar produccion con valores HTTPS finales.

# Desarrollo local
VITE_API_URL=http://localhost:3002
VITE_APP_URL=http://localhost:5173
VITE_AGENDA_SSE_ENABLED=true

# Produccion
# VITE_API_URL=https://api.masterfadeapp.com
# VITE_APP_URL=https://masterfadeapp.com
# VITE_SUPABASE_URL=https://pdzsmkjnyazpkoocjbpw.supabase.co
# VITE_SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
# VITE_SUPABASE_STORAGE_BUCKET_PUBLIC=imagenes_publicas
# VITE_SUPABASE_STORAGE_BUCKET_PRIVATE=imagenes_privadas

# Supabase local/dev o entorno activo
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Storage buckets
VITE_SUPABASE_STORAGE_BUCKET_PUBLIC=imagenes_publicas
VITE_SUPABASE_STORAGE_BUCKET_PRIVATE=imagenes_privadas

# Portal cliente / habilitacion temporal
# true = funcionalidad activa
# false = funcionalidad visible pero bloqueada
VITE_CLIENT_BOOKING_ENABLED=true
VITE_CLIENT_CITAS_ENABLED=true
VITE_CLIENT_PLAN_PURCHASE_ENABLED=true
VITE_CLIENT_LOCK_MESSAGE=Proximamente...

# Membresias VIP publicas / habilitacion temporal
VITE_VIP_MEMBERSHIPS_ENABLED=true
VITE_VIP_MEMBERSHIPS_LOCK_MESSAGE=Próximamente...
VITE_VIP_MEMBERSHIPS_PURCHASE_ENABLED=true
VITE_VIP_MEMBERSHIPS_PURCHASE_LOCK_MESSAGE=Próximamente...
